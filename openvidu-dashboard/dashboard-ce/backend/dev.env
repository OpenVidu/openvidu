# Defaults of ./dashboard.sh dev, for openvidu-local-deployment running on this machine. Override any of them in
# .env next to this file (git-ignored) or in the environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# The deployment's replica set advertises its member as mongo:27017, a name only Docker resolves.
DATABASE_URL=mongodb://mongoadmin:mongoadmin@localhost:27017/?directConnection=true
DASHBOARD_BASE_PATH=/
