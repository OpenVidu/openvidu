{
	"name": "@openvidu-dashboard/data-generator",
	"version": "3.10.0",
	"private": true,
	"description": "Generator of analytics data that follows the data model contract, for tests and local demos",
	"type": "module",
	"exports": {
		"./generator": "./src/generator.ts",
		"./live": "./src/live.ts",
		"./context": "./src/context.ts",
		"./cut": "./src/cut.ts",
		"./derive": "./src/derive.ts",
		"./model": "./src/model.ts",
		"./contract": "./src/contract.ts",
		"./plan": "./src/plan.ts",
		"./restart": "./src/restart.ts",
		"./random": "./src/random.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"generate": "tsx --conditions=source src/generate.ts",
		"keep-alive": "tsx --conditions=source src/keep-alive.ts",
		"live": "tsx --conditions=source src/live-cli.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@openvidu-dashboard/typings": "workspace:*",
		"mongodb": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
